# Deployer / owner key (testnet only, never commit .env)
PRIVATE_KEY=
PORTALDOT_EVM_RPC=https://test-evm-rpc-v3.portaldot.dev
# Only if deploys fail on gas (estimates on Portaldot can be inflated). Leave empty otherwise.
GAS_LIMIT=
GAS_PRICE_WEI=

# Agent (hot key, holds only gas; cannot move vault funds anywhere but into allowlisted circles)
AGENT_PRIVATE_KEY=
VAULT=
OWNER=
# Either list circles, or set REGISTRY and the agent finds every open/active circle you are a member of
REGISTRY=
CIRCUITS=
LEAD_SECONDS=3600
POLL_SECONDS=60

# Optional: lets the agent explain its decisions in plain language. Decisions never depend on it.
ANTHROPIC_API_KEY=

# Optional Telegram alerts (agent warns you before a deadline if it cannot pay)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: run the paid risk-report API (npm run service) and buy from it with the agent vault
SERVICE_TOKEN=
SERVICE_PAYEE=
SERVICE_PRICE=1000000
SERVICE_PORT=8402
